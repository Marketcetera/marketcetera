<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
  <Appenders>
    <Console name="STDOUT" target="SYSTEM_OUT">
      <PatternLayout pattern="%d %-5p [%t] %C{2} (%F:%L) - %m%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="warn">
      <AppenderRef ref="STDOUT"/>
    </Root>
    <logger name="org.marketcetera" level="debug"/>
    <logger name="org.marketcetera.rpc" level="trace"/>
    <logger name="org.marketcetera.rpc.client.AbstractRpcClient" level="trace"/>
    <logger name="org.marketcetera.rpc.server.RpcServer" level="trace"/>
    <logger name="org.marketcetera.rpc.RpcTestBase" level="trace"/>
    <logger name="io.grpc" level="debug"/>
  </Loggers>
</Configuration>